rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventory-items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /inventory-locations/{locationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
